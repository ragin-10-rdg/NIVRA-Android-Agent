<!--
  NIVRA custom detection rules.
  Install: /var/ossec/etc/rules/nivra_rules.xml, then restart wazuh-manager.
  Rule IDs use the 100XXX custom range per Wazuh convention.

  Severity levels are chosen to match this dashboard's 4-tier scheme
  (see wazuh-integration/dashboards/nivra_alert_catalog.md for the full
  per-rule table):
    Low       0-6   -- routine/authorized events, minor issues
    Medium    7-11  -- integrity warnings, first-time-seen behavior
    High     12-14  -- correlated attack-pattern matches, high importance
    Critical 15-16  -- confirmed severe attacks, near-zero false-positive
                        chance (reserved for exact threat-intel IOC
                        matches on the most severe categories only --
                        currently just ransomware; see 100134/100135)
-->
<group name="nivra,android,mobile,">

  <!--
    Matches on the built-in "json" decoder (ruleset/decoders/0006-json_decoders.xml),
    not nivra_decoder.xml's "nivra-json" -- confirmed via wazuh-logtest that the
    built-in decoder's broad `^{\s*"` prematch always wins that race regardless of
    decoder_dir load order or local_decoder.xml placement (and it can't be disabled
    to let ours win instead: other built-in rulesets, e.g. 0350-amazon_rules.xml,
    hard-depend on a decoder literally named "json"). JSON_Decoder's field
    flattening is identical either way, so gate on decoded_as=json plus the
    presence of schema_version instead of chasing decoder-name precedence.
  -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="schema_version">\.+</field>
    <description>NIVRA Android agent event received from $(device.device_id).</description>
  </rule>

  <!--
    Use case 1: failed unlock attempts.
    Fields read "details.*", not "data.*": nivra_receiver.py renames the
    event's own "data" object to "details" before writing it to the JSON
    Lines file Wazuh tails, because Wazuh's default alert index template
    reserves "data.data" as a plain keyword field (used by other built-in
    decoders for raw leftover text) -- any event whose "data" object landed
    there non-empty was silently dropped by the indexer even though it
    decoded and matched rules fine on the manager (confirmed via the
    wazuh-alerts-* index mapping: only HEARTBEAT, whose object is always
    {}, ever actually reached the dashboard).
  -->
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="event.type">SECURITY_LOG</field>
    <field name="details.subtype">failed_unlock</field>
    <field name="details.success">false</field>
    <description>NIVRA: Failed device unlock attempt on $(device.device_id).</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="12" frequency="5" timeframe="300">
    <if_matched_sid>100101</if_matched_sid>
    <description>NIVRA: 5+ failed unlock attempts on $(device.device_id) within 5 minutes -- possible brute-force / lost-or-stolen device.</description>
    <group>authentication_failures,</group>
  </rule>

  <!-- Use case 2: unexpected application installation (baseline-aware) -->
  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <field name="event.type">APPLICATION_INSTALL</field>
    <field name="details.approved">true</field>
    <description>NIVRA: New (approved-baseline) application installed on $(device.device_id): $(details.package_name).</description>
    <group>software_installation,</group>
  </rule>

  <rule id="100111" level="9">
    <if_sid>100100</if_sid>
    <field name="event.type">APPLICATION_INSTALL</field>
    <field name="details.approved">false</field>
    <description>NIVRA: UNEXPECTED application installed on managed device $(device.device_id): $(details.package_name) (not on approved baseline).</description>
    <group>software_installation,unexpected_application,</group>
  </rule>

  <!-- Use case 3: security-configuration drift -->
  <rule id="100120" level="8">
    <if_sid>100100</if_sid>
    <field name="event.type">SECURITY_CONFIGURATION</field>
    <field name="event.severity">MEDIUM</field>
    <description>NIVRA: Security-configuration drift detected on $(device.device_id): $(details.drifted_fields).</description>
    <group>configuration_changed,</group>
  </rule>

  <!--
    Use case 4: network activity + suspicious destinations.
    100130 itself is level="0" (correlation-only, same pattern as the
    100100 base rule -- see the HEARTBEAT comment below for why level 0
    still lets if_sid children fire without writing its own alert). Plain
    "app made a network connection" is not interesting on its own and was
    >95% of all NIVRA alert volume before this; only the restricted-
    destination child rules below (100131 hostname, 100132 IP) actually
    alert, and only they get written to wazuh-alerts-*/the dashboard.
    details.type is "dns" or "connect" (see NetworkCollector.kt) -- dns
    events carry details.hostname, connect events carry details.ip_address
    and details.port.
  -->
  <rule id="100130" level="0">
    <if_sid>100100</if_sid>
    <field name="event.type">NETWORK_EVENT</field>
    <description>NIVRA: $(details.type) from $(details.package_name) on $(device.device_id) -- host=$(details.hostname) ip=$(details.ip_address) port=$(details.port).</description>
    <group>network_activity,</group>
  </rule>

  <!--
    Real threat-intel IOC matches, sourced from
    wazuh-integration/threat-intel/iocs.csv (269 real IOCs from ThreatFox,
    URLhaus, MalwareBazaar, Blocklist.de, OpenPhish -- see that directory's
    README.md/wazuh_ioc_mapping.md for provenance and methodology). The
    CDB lists below are generated from that CSV
    (wazuh-integration/lists/build_cdb_lists.py-equivalent; regenerate and
    re-sync to the deployed stack whenever iocs.csv is refreshed) --
    replaces the old inline pcre2 placeholder patterns entirely. Only
    categories with a real outbound-telemetry match today (c2, phishing,
    ransomware, malware domains) are wired here; `scanning` and the IP
    side of `brute-force` in the dataset describe *inbound* attacker
    reputation, not something NIVRA's outbound-only NETWORK_EVENT can
    match against yet -- see wazuh_ioc_mapping.md's per-category notes.
  -->
  <rule id="100131" level="11">
    <if_sid>100130</if_sid>
    <list field="details.hostname" lookup="match_key">etc/lists/nivra_phishing_domains</list>
    <description>NIVRA: $(details.package_name) on $(device.device_id) resolved a known phishing hostname: $(details.hostname) (threat intel: nivra_phishing_domains).</description>
    <group>network_activity,threat_intel,restricted_destination,phishing,</group>
  </rule>

  <rule id="100132" level="12">
    <if_sid>100130</if_sid>
    <list field="details.ip_address" lookup="address_match_key">etc/lists/nivra_c2_ips</list>
    <description>NIVRA: $(details.package_name) on $(device.device_id) connected to a known C2 IP $(details.ip_address):$(details.port) (threat intel: nivra_c2_ips).</description>
    <group>network_activity,threat_intel,restricted_destination,c2,</group>
  </rule>

  <rule id="100133" level="12">
    <if_sid>100130</if_sid>
    <list field="details.hostname" lookup="match_key">etc/lists/nivra_c2_domains</list>
    <description>NIVRA: $(details.package_name) on $(device.device_id) resolved a known C2 hostname: $(details.hostname) (threat intel: nivra_c2_domains).</description>
    <group>network_activity,threat_intel,restricted_destination,c2,</group>
  </rule>

  <rule id="100134" level="15">
    <if_sid>100130</if_sid>
    <list field="details.ip_address" lookup="address_match_key">etc/lists/nivra_ransomware_ips</list>
    <description>NIVRA: $(details.package_name) on $(device.device_id) connected to a known ransomware-affiliated IP $(details.ip_address):$(details.port) (threat intel: nivra_ransomware_ips).</description>
    <group>network_activity,threat_intel,restricted_destination,ransomware,</group>
  </rule>

  <rule id="100135" level="15">
    <if_sid>100130</if_sid>
    <list field="details.hostname" lookup="match_key">etc/lists/nivra_ransomware_domains</list>
    <description>NIVRA: $(details.package_name) on $(device.device_id) resolved a known ransomware-affiliated hostname: $(details.hostname) (threat intel: nivra_ransomware_domains).</description>
    <group>network_activity,threat_intel,restricted_destination,ransomware,</group>
  </rule>

  <rule id="100136" level="10">
    <if_sid>100130</if_sid>
    <list field="details.hostname" lookup="match_key">etc/lists/nivra_malware_domains</list>
    <description>NIVRA: $(details.package_name) on $(device.device_id) resolved a known malware-distribution hostname: $(details.hostname) (threat intel: nivra_malware_domains).</description>
    <group>network_activity,threat_intel,restricted_destination,malware,</group>
  </rule>

  <!--
    ADB / administrative activity. Currently the only source of this event
    type is SecurityLogCollector.kt's TAG_ADB_SHELL_INTERACTIVE/
    TAG_ADB_SHELL_CMD handling, which the app itself tags Severity.HIGH --
    a confirmed OS-level detection of an actual ADB shell session on a
    managed device (not a heuristic), so this sits in the High tier
    alongside the other confirmed/correlated detections (100102, 100132,
    100133), not Medium.
  -->
  <rule id="100140" level="12">
    <if_sid>100100</if_sid>
    <field name="event.type">ADMIN_ACTIVITY</field>
    <description>NIVRA: ADB or administrative security activity detected on $(device.device_id).</description>
    <group>adb_activity,</group>
  </rule>

  <!--
    Heartbeat. level="3" (Wazuh's default log_alert_level floor), not 0:
    level-0 rules are correlation-only and are never written to
    wazuh-alerts-*, but nivra_offline_watchdog.py's known_devices() and
    last_heartbeat_time() both query wazuh-alerts-* for exactly these
    HEARTBEAT events -- at level 0 the watchdog would find no heartbeats
    for any device and treat every device as permanently offline. Use the
    "heartbeat" group below to filter these out of a dashboard's default
    alert view if the volume is noisy.
  -->
  <rule id="100150" level="3">
    <if_sid>100100</if_sid>
    <field name="event.type">HEARTBEAT</field>
    <description>NIVRA: Heartbeat received from $(device.device_id).</description>
    <group>heartbeat,</group>
  </rule>

  <!--
    Use case 5: agent-offline detection.
    Wazuh's rule engine alerts on event *presence*, not absence, so a
    companion watchdog (wazuh-integration/watchdog/nivra_offline_watchdog.py)
    queries the Wazuh Indexer for devices with no HEARTBEAT in the
    configured window, then writes a synthetic AGENT_OFFLINE event into the
    same JSON log this decoder parses. This rule fires on that synthetic
    event.
  -->
  <rule id="100151" level="12">
    <if_sid>100100</if_sid>
    <field name="event.type">AGENT_OFFLINE</field>
    <description>NIVRA: Device $(device.device_id) has not sent a heartbeat within the expected window -- agent may be offline, disabled, or the device compromised/tampered with.</description>
    <group>agent_offline,availability,</group>
  </rule>

  <!--
    Outdated security patch level.
    pcre2 field matching can't do real date arithmetic (no "more than 90
    days old"), so this whitelists the current + previous calendar year and
    flags everything else -- same static-pattern limitation as rule 100131's
    threat-intel placeholder above. MAINTENANCE: update the whitelisted
    years below at the start of each calendar year (last reviewed: 2026,
    whitelist 2025-2026), or replace this with a real freshness check
    computed on-device/receiver-side where date math is trivial.
  -->
  <rule id="100160" level="6">
    <if_sid>100100</if_sid>
    <field name="event.type">DEVICE_INFO</field>
    <field name="details.security_patch" type="pcre2">^(?!2025-|2026-)\d{4}-</field>
    <description>NIVRA: Device $(device.device_id) reporting an outdated security patch level ($(details.security_patch)).</description>
    <group>vulnerability,patch_management,</group>
  </rule>

</group>
